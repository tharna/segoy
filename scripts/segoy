#!/bin/sh
# segoy — set up and check repos that use the Segoy kit.
#
#   segoy init brain|project [--no-github] [--repo <owner>/<repo>]
#                            [--ways DIR] [--denylist FILE] <dir>
#       Copy kit/common and kit/<kind> into <dir> (never overwriting), write
#       .segoy/version and .segoy/manifest.json, and create the labels in
#       the GitHub repo through the REST API. For a project, CLAUDE.md is
#       generated with the brain's public ways (--ways) and leak-checked.
#   segoy sync [--dry-run] [--no-github] [--pr] [--branch NAME] [--pr-footer FILE] <dir>
#       Update <dir>'s kit files to this Segoy. Files the repo changed get the
#       new version beside them as <file>.segoy-new; config, notes and other
#       repo-owned files are left alone. --pr commits on a branch and opens a PR.
#   segoy doctor [<dir>] [--offline]
#       Check config, kit files, labels and branch rules.
#   segoy doctor --skills [<dir>]      Lint SKILL.md files.
#   segoy doctor --protocol FILE...    Validate `segoy` blocks.
#   segoy doctor --history [--denylist FILE] [--skip RULE] [<dir>]
#       Leak-check every file version and commit message in the git history.
#   segoy version
#
# Exit status: 0 ok, 1 checks failed, 2 usage or environment error.
# POSIX shell, git, gh (REST only) and jq.

# shellcheck source-path=SCRIPTDIR
set -u

SEGOY_HOME=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
export SEGOY_HOME

# shellcheck source=lib/common.sh
. "$SEGOY_HOME/scripts/lib/common.sh"
# shellcheck source=lib/init.sh
. "$SEGOY_HOME/scripts/lib/init.sh"
# shellcheck source=lib/doctor.sh
. "$SEGOY_HOME/scripts/lib/doctor.sh"
# shellcheck source=lib/sync.sh
. "$SEGOY_HOME/scripts/lib/sync.sh"

usage() { sed -n '2,23s/^# \{0,1\}//p' "$0"; }

cmd=${1:-}
[ $# -gt 0 ] && shift
case $cmd in
  init) cmd_init "$@" ;;
  doctor) cmd_doctor "$@" ;;
  version) segoy_version ;;
  sync) cmd_sync "$@" ;;
  -h|--help|help|'') usage ;;
  *) usage; exit 2 ;;
esac
